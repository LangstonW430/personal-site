---
/*
 * A real page, not a redirect. The obvious move for a 404 in this design is
 * a record page for a record that doesn't exist, so that's what this is —
 * the same rail-and-prose shape, an em dash where an accession would be,
 * restrained rather than played for a joke.
 */
import Base from '../layouts/Base.astro';
import NotFoundRecord from '../components/NotFoundRecord.astro';
---

<Base title="404 — Langston" description="No record at this address." path="/404/">
	<main id="main" class="px-entry py-register max-w-[62rem] mx-auto">
		<p class="no-print"><a href="/">&larr; Home</a></p>

		<NotFoundRecord />
	</main>
</Base>
