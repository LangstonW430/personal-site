---
/*
 * An accrual. Parent is looked up through the injected `record` field
 * against the records collection, never by re-parsing this article's id.
 * The return-to-parent link sits above the title, not below the body, so an
 * accrual can never read as a standalone post before a reader knows what
 * it's filed under.
 */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Time from '../../../components/Time.astro';
import { publishedArticles } from '../../../lib/content';

export async function getStaticPaths() {
	const [records, articles] = await Promise.all([getCollection('records'), getCollection('articles')]);
	const recordByAcc = new Map(records.map((record) => [record.data.acc, record]));

	// A draft article gets no route at all — not a page that exists but 404s
	// on purpose, simply never built. "Publishing is an explicit act" (the
	// schema's own words) means the URL doesn't exist until it is one.
	return publishedArticles(articles).map((article) => {
		const record = recordByAcc.get(article.data.record);
		if (!record) {
			throw new Error(
				`Accrual "${article.id}" references record "${article.data.record}", which does not exist.`,
			);
		}

		const slug = article.id.slice(article.id.indexOf('/') + 1);

		return {
			params: { id: record.id, article: slug },
			props: { article, record, slug },
		};
	});
}

interface Props {
	article: CollectionEntry<'articles'>;
	record: CollectionEntry<'records'>;
	slug: string;
}

const { article, record, slug } = Astro.props;
const { Content } = await render(article);
---

<Base
	title={`ACC. ${record.data.acc} — ${article.data.title}`}
	description={article.data.summary}
	path={`/${record.id}/${slug}/`}
>
	<main id="main" class="px-entry py-register max-w-[62rem] mx-auto">
		<p>
			<a href={`/${record.id}/`}>&larr; {record.data.acc} — {record.data.title}</a>
		</p>

		<article>
			<header>
				<p class="field-label mt-entry">Note</p>
				<p class="font-record font-typed text-md text-stamp">{article.data.note}</p>

				<h1 class="font-prose text-xl leading-display mt-hair">{article.data.title}</h1>
				<p class="font-prose leading-prose mt-field max-w-[62ch]">{article.data.summary}</p>
			</header>

			<div class="mt-register grid gap-entry grid-cols-1 md:grid-cols-[15rem_1fr]">
				<dl class="bg-card border border-rule p-entry flex flex-col gap-field">
					<div>
						<dt class="field-label">Filed</dt>
						<dd class="font-record font-typed text-sm leading-record">
							<Time date={article.data.filed} />
						</dd>
					</div>

					<div>
						<dt class="field-label">Condition</dt>
						<dd class="font-record font-typed text-sm leading-record">{article.data.condition}</dd>
					</div>

					{
						article.data.provenance && (
							<div>
								<dt class="field-label">Provenance</dt>
								<dd class="font-record font-typed text-sm leading-record">{article.data.provenance}</dd>
							</div>
						)
					}

					{
						article.data.extent?.words !== undefined && (
							<div>
								<dt class="field-label">Extent</dt>
								<dd class="font-record font-typed text-sm leading-record">
									{article.data.extent.words.toLocaleString('en-US')} words
								</dd>
							</div>
						)
					}

					<div>
						<dt class="field-label">Record</dt>
						<dd class="font-record font-typed text-sm leading-record">
							<a href={`/${record.id}/`}>{record.data.acc}</a>
						</dd>
					</div>
				</dl>

				<div class="font-prose leading-prose max-w-[62ch]">
					<Content />
				</div>
			</div>

			<p class="mt-register no-print">
				<a href={`/${record.id}/`}>&larr; Back to {record.data.acc} — {record.data.title}</a>
			</p>
		</article>
	</main>
</Base>
