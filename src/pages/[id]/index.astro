---
/*
 * A record. `<article>` wraps the whole entry; fields render as a real `<dl>`
 * inside a `bg-card` panel — the rail — against a wide prose column, per
 * CLAUDE.md's layout principle. The panel is deliberate: see the note above
 * the rail markup for why it holds at every viewport width instead of
 * collapsing into plain stacked text on mobile.
 *
 * Every schema field that carries display meaning is rendered and labelled;
 * an absent optional field skips its label rather than rendering empty.
 * `order` and `featured` are sort/promotion mechanics with no field label in
 * CLAUDE.md's vocabulary, so they drive behavior elsewhere and are not
 * printed here.
 *
 * `prerender = false`: the second dynamic route on the site, after `/`. A
 * record with a github.com `links.source` gets its README fetched live
 * (same instrument-panel pattern as the homepage — LIVE/UNAVAILABLE stamp,
 * 5-minute edge cache) so an update to the actual repo shows up here without
 * a rebuild. That live fetch is genuinely per-request, so the whole route
 * has to be SSR — Astro's static/dynamic switch is per source file, not per
 * generated path, and a dynamic `[id]` can't prerender five records while
 * SSR-ing three others. The other five records pay for this in build-output
 * purity only: nothing observable changes for a visitor, they're still
 * served fast, just via the same Vercel function as every other record now
 * instead of a static file.
 */
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NotFoundRecord from '../../components/NotFoundRecord.astro';
import Time from '../../components/Time.astro';
import { formatExtent } from '../../lib/format';
import { fetchReadme, parseGithubSource, type ReadmeData } from '../../lib/github';
import { publishedArticles } from '../../lib/content';
import { EXTERNAL_LINK_ATTRS } from '../../lib/links';

export const prerender = false;

const id = Astro.params.id;
const record = id ? await getEntry('records', id) : undefined;

// Astro won't let an on-demand route rewrite to a prerendered one
// (404.astro stays static, matching Vercel's own not-found handling for
// URLs outside every route pattern) — so a record id that matches nothing
// renders the same NotFoundRecord content directly, at this URL, with a
// real 404 status, instead of rewriting to /404.
if (!record) Astro.response.status = 404;

let accruals: { article: CollectionEntry<'articles'>; slug: string }[] = [];
let Content: Awaited<ReturnType<typeof render>>['Content'] | null = null;
let extent: string | null = null;
let hasLinks = false;
let githubSource: ReturnType<typeof parseGithubSource> = null;
let readme: ReadmeData | null = null;

if (record) {
	const articles = await getCollection('articles');
	accruals = publishedArticles(articles)
		.filter((article) => article.data.record === record.data.acc)
		.map((article) => ({ article, slug: article.id.slice(article.id.indexOf('/') + 1) }))
		.sort((a, b) => a.article.data.note - b.article.data.note);

	({ Content } = await render(record));

	extent = formatExtent(record.data.extent);
	hasLinks = Boolean(record.data.links.live || record.data.links.source || record.data.links.writeup);

	githubSource = parseGithubSource(record.data.links.source);
	if (githubSource) {
		// Same rationale as index.astro's own GITHUB_TOKEN read: process.env,
		// not import.meta.env, because this has to be a genuine runtime lookup
		// rather than a value Vite bakes into the build.
		readme = await fetchReadme(githubSource.owner, githubSource.repo, process.env.GITHUB_TOKEN);
	}
}
const readmeCheckedAt = new Date();

Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=300');
---

<Base
	title={record ? `ACC. ${record.data.acc} — ${record.data.title}` : '404 — Langston'}
	description={record ? record.data.summary : 'No record at this address.'}
	path={record ? `/${record.id}/` : Astro.url.pathname}
	image={record ? `/og/${record.id}.png` : undefined}
>
	<main id="main" class="px-entry py-register max-w-[62rem] mx-auto">
		<p class="no-print"><a href={record ? '/work/' : '/'}>&larr; {record ? 'Register' : 'Home'}</a></p>

		{!record && <NotFoundRecord />}
		{record && (

		<article>
			<header>
				<p class="field-label mt-entry">Acc.</p>
				<p class="font-record font-typed text-md text-stamp">{record.data.acc}</p>

				<h1 class="font-prose text-xl leading-display mt-hair">{record.data.title}</h1>
				<p class="font-prose leading-prose mt-field max-w-[62ch]">{record.data.summary}</p>
			</header>

			<div class="mt-register grid gap-entry grid-cols-1 md:grid-cols-[15rem_1fr]">
				<!--
					The rail. `bg-card` on `board` is the same value step the rest of
					the site uses for depth — here it also solves the mobile problem:
					stacked full-width, this panel still reads as a mounted specimen
					tag distinct from the page ground, not as paragraphs of running
					text. The dt/dd pairing (label above value) doesn't change between
					breakpoints — only the panel's position relative to the prose
					column does, beside it at md: and above it below that.
				-->
				<dl class="bg-card border border-rule p-entry flex flex-col gap-field">
					{
						record.data.client && (
							<div>
								<dt class="field-label">Client</dt>
								<dd class="font-record font-typed text-sm leading-record">{record.data.client}</dd>
							</div>
						)
					}

					<div>
						<dt class="field-label">Role</dt>
						<dd class="font-record font-typed text-sm leading-record">{record.data.role}</dd>
					</div>

					<div>
						<dt class="field-label">Medium</dt>
						<dd class="font-record font-typed text-sm leading-record">{record.data.medium.join(' · ')}</dd>
					</div>

					<div>
						<dt class="field-label">Acquired</dt>
						<dd class="font-record font-typed text-sm leading-record">
							<Time date={record.data.acquired} />
						</dd>
					</div>

					{
						record.data.completed && (
							<div>
								<dt class="field-label">Completed</dt>
								<dd class="font-record font-typed text-sm leading-record">
									<Time date={record.data.completed} />
								</dd>
							</div>
						)
					}

					<div>
						<dt class="field-label">Status</dt>
						<dd class="font-record font-typed text-sm leading-record">{record.data.status.toUpperCase()}</dd>
					</div>

					{
						extent && (
							<div>
								<dt class="field-label">Extent</dt>
								<dd class="font-record font-typed text-sm leading-record">{extent}</dd>
							</div>
						)
					}

					<div>
						<dt class="field-label">Condition</dt>
						<dd class="font-record font-typed text-sm leading-record whitespace-pre-line">{record.data.condition}</dd>
					</div>

					{
						record.data.locality && (
							<div>
								<dt class="field-label">Locality</dt>
								<dd class="font-record font-typed text-sm leading-record">{record.data.locality}</dd>
							</div>
						)
					}

					{
						record.data.history && record.data.history.length > 0 && (
							<div>
								<dt class="field-label">History</dt>
								<dd>
									<ul role="list" class="flex flex-col gap-hair mt-hair">
										{record.data.history.map((entry) => (
											<li class="font-record font-typed text-sm leading-record">
												<Time date={entry.date} /> — {entry.note}
											</li>
										))}
									</ul>
								</dd>
							</div>
						)
					}

					{
						hasLinks && (
							<div>
								<dt class="field-label">Links</dt>
								<dd>
									<ul role="list" class="flex flex-col gap-hair mt-hair font-record font-typed text-sm">
										{record.data.links.live && (
											<li>
												<a href={record.data.links.live} {...EXTERNAL_LINK_ATTRS}>Live</a>
											</li>
										)}
										{record.data.links.source && (
											<li>
												<a href={record.data.links.source} {...EXTERNAL_LINK_ATTRS}>Source</a>
											</li>
										)}
										{record.data.links.writeup && (
											<li>
												<a
													href={record.data.links.writeup}
													{...(record.data.links.writeup.startsWith('/') ? {} : EXTERNAL_LINK_ATTRS)}
												>
													Writeup
												</a>
											</li>
										)}
									</ul>
								</dd>
							</div>
						)
					}
				</dl>

				<div class="font-prose leading-prose max-w-[62ch]">{Content && <Content />}</div>
			</div>

			{
				accruals.length > 0 && (
					<section class="mt-register grid gap-entry grid-cols-1 md:grid-cols-[15rem_1fr]">
						<h2 class="field-label">Accruals</h2>
						<ul role="list" class="flex flex-col gap-entry">
							{accruals.map(({ article, slug }) => (
								<li class="relative border-b border-rule pb-field">
									<a href={`/${record.id}/${slug}/`} class="absolute inset-0">
										<span class="sr-only">
											Note {article.data.note} — {article.data.title}
										</span>
									</a>
									<p class="field-label">Note {article.data.note}</p>
									<p class="font-prose text-md leading-display mt-hair">{article.data.title}</p>
									<p class="font-record font-typed text-sm mt-pair">
										<Time date={article.data.filed} /> · {article.data.condition}
									</p>
								</li>
							))}
						</ul>
					</section>
				)
			}

			{
				githubSource && (
					<section class="mt-register bg-card border border-rule p-entry">
						<div class="flex items-baseline justify-between flex-wrap gap-field">
							<p class="field-label">README</p>
							<p class="font-record font-typed text-xs text-stamp">{readme ? 'LIVE' : 'UNAVAILABLE'}</p>
						</div>

						{
							readme ? (
								<details class="mt-field">
									<summary class="cursor-pointer font-record font-typed text-sm">
										{githubSource.owner}/{githubSource.repo}
									</summary>
									<div class="readme-content font-prose leading-prose mt-entry max-w-[62ch]" set:html={readme.html} />
								</details>
							) : (
								<p class="font-record font-typed text-sm mt-field">
									Unavailable. Checked <Time date={readmeCheckedAt} />.
								</p>
							)
						}
					</section>
				)
			}
		</article>
		)}
	</main>
</Base>
