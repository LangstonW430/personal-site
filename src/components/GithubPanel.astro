---
/*
 * The instrument panel. `stamp` marks the freshness readout — CLAUDE.md
 * reserves that ink for accession numbers, live-data indicators, and focus
 * rings; this is the live-data indicator the token system was always meant
 * to carry, arriving in this phase.
 *
 * No fabricated "last synchronized" claim on failure: this is a stateless
 * per-request render with no store, so there's no persisted prior-success
 * timestamp to reference honestly. The unavailable state says what it
 * actually knows — that this attempt, at this time, failed — rather than
 * inventing a synchronized-at time it doesn't have.
 */
import Time from './Time.astro';
import type { GithubPanelData } from '../lib/github';
import { EXTERNAL_LINK_ATTRS } from '../lib/links';

interface Props {
	data: GithubPanelData | null;
	checkedAt: Date;
}

const { data, checkedAt } = Astro.props;

const mostRecentPush = data?.repos.length
	? data.repos.reduce((latest, repo) => (repo.pushedAt > latest ? repo.pushedAt : latest), data.repos[0].pushedAt)
	: null;
---

<section class="mt-register bg-card border border-rule p-entry">
	<div class="flex items-baseline justify-between flex-wrap gap-field">
		<p class="field-label">GitHub</p>
		<p class="font-record font-typed text-xs text-stamp">{data ? 'LIVE' : 'UNAVAILABLE'}</p>
	</div>

	{
		data ? (
			<>
				<p class="font-record font-typed text-sm mt-field">
					{data.publicRepoCount} public {data.publicRepoCount === 1 ? 'repository' : 'repositories'} · most
					recent push{' '}
					{mostRecentPush && <Time date={new Date(mostRecentPush)} class="text-stamp" />}
				</p>

				<ul role="list" class="mt-entry flex flex-col gap-field">
					{data.repos.map((repo) => (
						<li class="border-b border-rule pb-field">
							<a href={repo.url} class="font-record font-typed text-sm text-stamp" {...EXTERNAL_LINK_ATTRS}>
								{repo.owner}/{repo.name}
							</a>
							<p class="font-record font-typed text-xs mt-hair">
								{repo.language ?? '—'} · pushed <Time date={new Date(repo.pushedAt)} />
								{repo.openIssues > 0 && ` · ${repo.openIssues} open ${repo.openIssues === 1 ? 'issue' : 'issues'}`}
							</p>
						</li>
					))}
				</ul>
			</>
		) : (
			<p class="font-record font-typed text-sm mt-field">
				Unavailable. Checked <Time date={checkedAt} />.
			</p>
		)
	}
</section>
