---
/*
 * The "no record at this address" body — shared between the static 404 page
 * (a genuinely unmatched URL, handled at the hosting layer) and the dynamic
 * `[id]` route's own not-found case (a URL that matches the record pattern
 * syntactically but names no real record). Astro won't let an on-demand
 * route rewrite to a prerendered one, so the SSR route renders this
 * component directly instead of 404.astro, both wrapped in their own
 * `<Base>` with the response status set to 404 by the caller.
 */
---

<article>
	<header>
		<p class="field-label mt-entry">Acc.</p>
		<p class="font-record font-typed text-md text-stamp">—</p>

		<h1 class="font-prose text-xl leading-display mt-hair">No record at this address</h1>
		<p class="font-prose leading-prose mt-field max-w-[62ch]">
			The register has no entry for this URL. It was never accessioned, or the address is wrong.
		</p>
	</header>

	<div class="mt-register grid gap-entry grid-cols-1 md:grid-cols-[15rem_1fr]">
		<dl class="bg-card border border-rule p-entry flex flex-col gap-field">
			<div>
				<dt class="field-label">Status</dt>
				<dd class="font-record font-typed text-sm leading-record">NOT FOUND</dd>
			</div>
		</dl>

		<div class="font-prose leading-prose max-w-[62ch]">
			<p><a href="/">Return to the register</a> and look for the work by title instead.</p>
		</div>
	</div>
</article>
