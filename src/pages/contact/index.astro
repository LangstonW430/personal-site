---
/* The intro prose is still Langston's to write — [[UNWRITTEN]] stays visible
 * there, same as every other body paragraph on the site. The channel
 * fields below are different: a short field left unwritten now hides
 * entirely rather than showing the sentinel, and both read from the same
 * profile.yaml the masthead does, so this page can't state a different
 * email than the one on the register. */
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { isUnwritten } from '../../lib/content';

const profile = await getEntry('profile', 'profile');
if (!profile) throw new Error('src/content/profile.yaml is missing or failed to load.');

const hasEmail = !isUnwritten(profile.data.email);
---

<Base title="Contact — Langston" description="Get in touch." path="/contact/">
	<main id="main" class="px-entry py-register max-w-[62rem] mx-auto">
		<p class="no-print"><a href="/">&larr; Register</a></p>

		<article>
			<header>
				<h1 class="font-prose text-xl leading-display mt-entry">Contact</h1>
				<p class="font-prose leading-prose mt-field max-w-[62ch]">
					[[UNWRITTEN]] A line or two on what kind of work this is for — recruiting conversations,
					freelance inquiries — and what to expect back.
				</p>
			</header>

			{
				(hasEmail || profile.data.githubProfile) && (
					<dl class="mt-register bg-card border border-rule p-entry flex flex-col gap-field max-w-[24rem]">
						{hasEmail && (
							<div>
								<dt class="field-label">Email</dt>
								<dd class="font-record font-typed text-sm leading-record">
									<a href={`mailto:${profile.data.email}`}>{profile.data.email}</a>
								</dd>
							</div>
						)}
						{profile.data.githubProfile && (
							<div>
								<dt class="field-label">Elsewhere</dt>
								<dd class="font-record font-typed text-sm leading-record">
									<a href={profile.data.githubProfile}>GitHub</a>
								</dd>
							</div>
						)}
					</dl>
				)
			}
		</article>
	</main>
</Base>
