---
/*
 * The document shell every route shares: doctype, Head, skip link, body
 * grounds. What differs per page — the register's tabular list, a record's
 * rail-and-prose split — starts inside the slot, because CLAUDE.md's layout
 * principle is that no two of those share a grid.
 */
import Head from '../components/Head.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	path: string;
	image?: string;
}

const { title, description, path, image } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<Head title={title} description={description} path={path} image={image} />
	</head>
	<body class="bg-board text-ink">
		<a href="#main" class="skip-link">Skip to record</a>
		<slot />

		<!--
			Structural navigation, not a nav bar with a logo — a document's
			back matter, in the same Commit Mono every record field uses. It's a
			footer rather than a persistent header because every page already
			carries its own "&larr; back" link at the top for its own parent;
			this is the one place the non-record destinations are reachable
			from anywhere, uniformly, without competing with that.
		-->
		<footer class="no-print border-t border-rule mt-section px-entry py-entry">
			<nav aria-label="Site">
				<ul role="list" class="flex flex-wrap gap-x-entry gap-y-hair font-record font-typed text-sm">
					<li><a href="/">Home</a></li>
					<li><a href="/work/">Project Register</a></li>
					<li><a href="/contact/">Contact</a></li>
					<li><a href="/colophon/">Colophon</a></li>
				</ul>
			</nav>
		</footer>
	</body>
</html>
