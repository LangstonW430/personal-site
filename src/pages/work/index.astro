---
/*
 * The full register, split out from `/` so the homepage can stay a
 * 30-second read: a three-record preview there links here for the rest.
 * Same table markup as that preview (RegisterTable.astro), every record
 * instead of three.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RegisterTable from '../../components/RegisterTable.astro';

// Newest accession first. An accession book is written oldest-first, and this
// read that way until 2026-11-20 — but a register is bound and read from the
// front, while this is a page someone lands on and scans from the top. Oldest
// first spent that position on the earliest work and pushed the most recent to
// the bottom, and it disagreed with the homepage preview, which has always
// shown the newest three. The accession numbers still say what the order of
// entry was; they just no longer have to carry the reading order too.
const records = (await getCollection('records')).sort((a, b) => b.data.acc.localeCompare(a.data.acc));
---

<Base
	title="Project Register — Langston Woods"
	description="The full register of software and web development work: accession number, medium, and status for each entry."
	path="/work/"
>
	<main id="main" class="px-entry py-register max-w-[75rem] mx-auto">
		<p class="no-print"><a href="/">&larr; Home</a></p>

		<h1 class="font-prose text-xl leading-display mt-entry">Project Register</h1>

		<RegisterTable records={records} />
	</main>
</Base>
