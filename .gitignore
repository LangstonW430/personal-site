# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
# Glob, not a list. astro.config.mjs bridges .env files into process.env via
# Vite's loadEnv, which reads .env, .env.local and .env.<mode>[.local] — and
# `netlify env:pull` writes .env by default. Naming files one at a time is how
# a real credential ends up in a commit: the file that leaks is the variant
# nobody thought to add.
.env*
!.env.example

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# netlify — the adapter's build output (SSR function, edge middleware,
# generated config), not the committed netlify.toml
.netlify/
