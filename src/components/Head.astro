---
/**
 * The one place `<title>`, description, canonical, and OG/Twitter tags are
 * assembled, so every route states them the same way instead of five pages
 * agreeing by coincidence.
 */
export interface Props {
	title: string;
	description: string;
	/** Root-relative pathname, e.g. "/2026.03-promptdesk/". Resolved against `site`. */
	path: string;
	/** Root-relative OG image path, e.g. "/og/2026.03-promptdesk.png". Optional — not every route has one. */
	image?: string;
}

const { title, description, path, image } = Astro.props;
const canonical = new URL(path, Astro.site).toString();
const ogImage = image ? new URL(image, Astro.site).toString() : undefined;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<!--
  "LW" set in Commit Mono, stamp on card — the same two colours and the same
  face every accession number on the site uses. Built by scripts/build-favicon.mjs
  and committed; it is not regenerated at build time.

  SVG first, .ico second: browsers that understand the SVG take it and scale
  cleanly to any density, and the rest fall through to the .ico, which carries
  16/32/48 rasters in one file. Order matters — the .ico must come after, or
  Chrome takes it and ignores the vector.
-->
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="canonical" href={canonical} />

<title>{title}</title>
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{ogImage && <meta property="og:image" content={ogImage} />}
{ogImage && <meta property="og:image:width" content="1200" />}
{ogImage && <meta property="og:image:height" content="630" />}

<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}

<!--
  Umami Cloud, the one script the site ships. Cookieless: it sets no cookies and
  stores no personal data, so it needs no consent banner. Loaded `defer`, so it never blocks the document; every page reads in
  full with it blocked or with JavaScript off.

  PROD-only so `astro dev` sends nothing, and `data-domains` so preview
  deploys on *.vercel.app don't either — only langstonwoods.com is counted.
  The website ID is public by design (it is in every page's source anyway).

  It is a third-party request, which this project otherwise avoids (see the
  font guard in astro.config.mjs). Proxying it through this domain would
  fix that and cut ad-blocker losses, but @astrojs/vercel ignores
  vercel.json rewrites, so it needs a build hook — deferred, not forgotten.

  Outbound clicks are tagged with `track()` from src/lib/links.ts.
-->
{
	import.meta.env.PROD && (
		<script
			is:inline
			defer
			src="https://cloud.umami.is/script.js"
			data-website-id="ded85f29-3903-499c-b337-44e67f3f861a"
			data-domains="langstonwoods.com"
		></script>
	)
}
