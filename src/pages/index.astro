---
/*
 * The homepage answers "who is this and can he do the job" before it
 * answers "what is this document." Name is the <h1>; Experience stands with
 * the masthead as more of the same answer. Register is a three-record
 * preview in the same field typography as the full table at /work/ — enough
 * to prove there's real work without asking a stranger to read all eight
 * records before deciding to keep going.
 *
 * Order: masthead, Experience, register preview, then GitHub and Recent
 * Changes — both instruments about the work, which only mean something once
 * a visitor already knows there's work to look at. Experience sits with the
 * masthead rather than after the register: it's still "who is this," a
 * compact read of the same chronology /biographical-note/ gives in full, not
 * a claim about the work below.
 *
 * `prerender = false`: this is the one route on the site that isn't static.
 * `server:defer` was the brief's first idea, but Astro's actual server-island
 * implementation injects a client-side `fetch` to swap the island in — that
 * directly violates zero-client-JS, which is the more load-bearing
 * constraint. SSR-ing this one route instead, with an HTTP cache-control
 * header doing the 5-minute caching at the edge, gets a live GitHub readout
 * with genuinely zero client JS, at the cost of `/` no longer being a static
 * file in `dist/` — every other route is untouched.
 */
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import GithubPanel from '../components/GithubPanel.astro';
import RegisterTable from '../components/RegisterTable.astro';
import Time from '../components/Time.astro';
import { fetchGithubPanel, repoAllowlist, type GithubPanelData } from '../lib/github';
import { CHRONOLOGY_KIND_LABEL, isUnwritten, sortedChronology } from '../lib/content';

export const prerender = false;

const GITHUB_USERNAME = 'LangstonW430';
// Kept in sync with astro.config.mjs's linkedFileGuard calls by convention.
const RESUME_PATH = '/resume.pdf';
const TRANSCRIPT_PATH = '/transcript.pdf';

const records = (await getCollection('records')).sort((a, b) => a.data.acc.localeCompare(b.data.acc));
const articles = await getCollection('articles');
const profile = await getEntry('profile', 'profile');
if (!profile) throw new Error('src/content/profile.yaml is missing or failed to load — the masthead has nothing to read.');

// Same source and sort as /biographical-note/'s Chronology — this is the
// compact version, three lines instead of the full note, with a link out
// to the rest. Not a second source of truth: both pages read profile.yaml
// through the same sortedChronology() helper.
const chronology = sortedChronology(profile.data.chronology);

// This site's own build history (2026.08) is excluded from both the
// homepage's top-3 preview and Recent Changes — it belongs on that record's
// page. A homepage whose headline work, or most recent activity, is all
// about itself isn't evidence of anything else.
const SELF_ACC = '2026.08';

// `featured` is the explicit override (none set yet); with none set, the 3
// most recently accessioned non-self records lead instead. Either way this
// is a preview, not a second copy of the register — /work/ has the rest.
const featured = records.filter((record) => record.data.featured);
const topRecords = (featured.length > 0 ? featured : records.filter((record) => record.data.acc !== SELF_ACC))
	.slice()
	.sort((a, b) => b.data.order - a.data.order)
	.slice(0, 3);

const allowlist = repoAllowlist(records.map((record) => record.data.links.source));

let githubData: GithubPanelData | null = null;
try {
	// `process.env`, not `import.meta.env` — Vite statically inlines
	// `import.meta.env.X` at build time (verified: building with a fake
	// GITHUB_TOKEN baked its literal value into the deployed function bundle),
	// which is exactly wrong for a secret that has to be read fresh from
	// Vercel's runtime environment on every invocation, rotatable without a
	// rebuild. `process.env.GITHUB_TOKEN` is a genuine runtime lookup.
	githubData = await fetchGithubPanel(GITHUB_USERNAME, allowlist, process.env.GITHUB_TOKEN);
} catch {
	// Unavailable — GithubPanel renders the honest "unavailable" state. The
	// rest of the register is unaffected; nothing here re-throws.
	githubData = null;
}
const githubCheckedAt = new Date();

// 5-minute edge cache: a reload within the window is served from Vercel's
// cache, not a fresh round trip to the GitHub API. `stale-while-revalidate`
// means a visitor who lands right as the cache expires still gets the
// previous (briefly stale) render instantly while the next one refreshes in
// the background, rather than blocking on a live fetch.
Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=300');

type Change = {
	date: Date;
	kind: 'Accessioned' | 'Filed' | 'Revised';
	label: string;
	href: string;
};

const recordByAcc = new Map(records.map((record) => [record.data.acc, record]));

const changes: Change[] = [
	...records
		.filter((record) => record.data.acc !== SELF_ACC)
		.map(
			(record): Change => ({
				date: record.data.acquired,
				kind: 'Accessioned',
				label: `${record.data.acc} — ${record.data.title}`,
				href: `/${record.id}/`,
			}),
		),
	...records
		.filter((record) => record.data.acc !== SELF_ACC)
		.flatMap((record) =>
			(record.data.history ?? []).map(
				(entry): Change => ({
					date: entry.date,
					kind: 'Revised',
					label: `${record.data.acc} — ${entry.note}`,
					href: `/${record.id}/`,
				}),
			),
		),
	...articles
		.filter((article) => article.data.record !== SELF_ACC)
		.flatMap((article): Change[] => {
			const parent = recordByAcc.get(article.data.record);
			if (!parent) return [];
			const slug = article.id.slice(article.id.indexOf('/') + 1);
			return [
				{
					date: article.data.filed,
					kind: 'Filed',
					label: `${parent.data.acc}, note ${article.data.note} — ${article.data.title}`,
					href: `/${parent.id}/${slug}/`,
				},
			];
		}),
];

changes.sort((a, b) => b.date.getTime() - a.date.getTime());
const RECENT_CHANGES_LIMIT = 5;
const recentChanges = changes.slice(0, RECENT_CHANGES_LIMIT);
---

<Base
	title={`${profile.data.name} — register of works`}
	description="A register of software and web development work: accession number, medium, extent, and condition for each entry."
	path="/"
>
	<main id="main" class="px-entry py-register max-w-[75rem] mx-auto">
		<h1 class="font-prose text-xl leading-display">{profile.data.name}</h1>

		<!--
			The masthead. Passport-page density: labelled fields, nothing
			decorative, larger and denser than a standard record field so it
			cannot be skipped the way a 10px line could be. Every field that
			might still be unfilled checks isUnwritten() (src/lib/content.ts)
			first — an unfilled field is simply absent, never visible
			placeholder text, on this page or any other.
		-->
		<section class="mt-field bg-card border border-rule p-entry">
			<dl class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-entry gap-y-field">
				<div>
					<dt class="field-label">Institution</dt>
					<dd class="font-record font-typed text-md mt-hair">{profile.data.institution}</dd>
				</div>

				{
					!isUnwritten(profile.data.degree) && (
						<div>
							<dt class="field-label">Degree</dt>
							<dd class="font-record font-typed text-md mt-hair">{profile.data.degree}</dd>
						</div>
					)
				}

				{
					!isUnwritten(profile.data.graduation) && (
						<div>
							<dt class="field-label">Expected Graduation</dt>
							<dd class="font-record font-typed text-md mt-hair">{profile.data.graduation}</dd>
						</div>
					)
				}

				{
					!isUnwritten(profile.data.gpa) && (
						<div>
							<dt class="field-label">GPA</dt>
							<dd class="font-record font-typed text-md mt-hair">{profile.data.gpa}</dd>
						</div>
					)
				}

				<div>
					<dt class="field-label">Role</dt>
					<dd class="font-record font-typed text-md mt-hair">{profile.data.role}</dd>
				</div>

				<div>
					<dt class="field-label">Location</dt>
					<dd class="font-record font-typed text-md mt-hair">{profile.data.location}</dd>
				</div>

				{
					!isUnwritten(profile.data.availability) && (
						<div>
							<dt class="field-label">Availability</dt>
							<dd class="font-record font-typed text-md mt-hair text-stamp">{profile.data.availability}</dd>
						</div>
					)
				}

				{
					!isUnwritten(profile.data.email) && (
						<div>
							<dt class="field-label">Email</dt>
							<dd class="font-record font-typed text-md mt-hair break-all">
								<a href={`mailto:${profile.data.email}`}>{profile.data.email}</a>
							</dd>
						</div>
					)
				}

				<div>
					<dt class="field-label">Resume</dt>
					<dd class="font-record font-typed text-md mt-hair">
						<a href={RESUME_PATH}>Download (PDF)</a>
					</dd>
				</div>

				<div>
					<dt class="field-label">Transcript</dt>
					<dd class="font-record font-typed text-md mt-hair">
						<a href={TRANSCRIPT_PATH}>Download (PDF)</a>
					</dd>
				</div>

				<div>
					<dt class="field-label">GitHub</dt>
					<dd class="font-record font-typed text-md mt-hair break-all">
						<a href={profile.data.githubProfile}>{profile.data.githubProfile.replace('https://', '')}</a>
					</dd>
				</div>

				<div>
					<dt class="field-label">Contact</dt>
					<dd class="font-record font-typed text-md mt-hair">
						<a href="/contact/">Get in touch</a>
					</dd>
				</div>
			</dl>
		</section>

		{
			chronology.length > 0 && (
				<section class="mt-register bg-card border border-rule p-entry">
					<h2 class="field-label">Experience</h2>
					<ul role="list" class="mt-field flex flex-col gap-field">
						{chronology.map((entry) => (
							<li class="border-b border-rule pb-field last:border-b-0 last:pb-0">
								{entry.detail ? (
									<details>
										<summary class="cursor-pointer flex flex-wrap items-baseline gap-pair">
											<span class="field-label shrink-0">{CHRONOLOGY_KIND_LABEL[entry.kind]}</span>
											<span class="font-record font-typed text-sm">
												{entry.date ? <Time date={entry.date} /> : 'Date TBD'} — {entry.note}
											</span>
										</summary>
										<ul role="list" class="list-disc pl-entry mt-pair flex flex-col gap-hair max-w-[62ch]">
											{entry.detail.map((line) => (
												<li class="font-prose text-sm leading-record">{line}</li>
											))}
										</ul>
									</details>
								) : (
									<div class="flex flex-wrap items-baseline gap-pair">
										<span class="field-label shrink-0">{CHRONOLOGY_KIND_LABEL[entry.kind]}</span>
										<span class="font-record font-typed text-sm">
											{entry.date ? <Time date={entry.date} /> : 'Date TBD'} — {entry.note}
										</span>
									</div>
								)}
							</li>
						))}
					</ul>
					<p class="font-record font-typed text-xs mt-field">
						<a href="/biographical-note/">Full biographical note &amp; résumé &rarr;</a>
					</p>
				</section>
			)
		}

		<h2 class="field-label mt-entry">Register</h2>

		<RegisterTable records={topRecords} />

		<p class="font-record font-typed text-xs mt-field">
			<a href="/work/">View full register &rarr;</a>
		</p>

		<GithubPanel data={githubData} checkedAt={githubCheckedAt} />

		{
			recentChanges.length > 0 && (
				<section class="mt-register bg-card border border-rule p-entry">
					<h2 class="field-label">Recent changes</h2>
					<ul role="list" class="flex flex-col gap-pair mt-field">
						{recentChanges.map((change) => (
							<li class="flex flex-wrap items-baseline gap-pair">
								<Time date={change.date} class="font-record font-typed text-xs text-ink-muted shrink-0" />
								<span class="field-label shrink-0">{change.kind}</span>
								<a href={change.href} class="font-record font-typed text-sm">
									{change.label}
								</a>
							</li>
						))}
					</ul>
				</section>
			)
		}
	</main>
</Base>
