 * Holding page. Not a design — Phase 2 owns `/`.
 *
 * It exists for two reasons: something has to answer at the root for the
 * Vercel deploy to be meaningfully green, and it is the only place the font
 * pipeline gets exercised over a real CDN rather than localhost.
 *
 * Every word on it is true. Nothing here is placeholder copy waiting to be
 * swapped for real copy; the whole file is deleted and rewritten in Phase 2.
 */
import '../styles/global.css';
